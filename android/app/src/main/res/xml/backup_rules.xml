<?xml version="1.0" encoding="utf-8"?>
<!-- flutter_secure_storage encrypts with an Android Keystore key that never
     leaves the device, so a restored copy can't be decrypted. Keep it out. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
</full-backup-content>