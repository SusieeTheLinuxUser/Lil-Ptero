<?xml version="1.0" encoding="utf-8"?>
<!-- flutter_secure_storage encrypts with an Android Keystore key that never
     leaves the device, so a restored copy can't be decrypted. Keep it out. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
    </device-transfer>
</data-extraction-rules>